# ==============================================================================
# URBANMOVE - Variables de Entorno del Entorno Base (.env.example)
# ==============================================================================
# INSTRUCCIONES:
# Copia este archivo como .env en la raíz del proyecto para desarrollo local:
#   cp .env.example .env      (Linux/macOS)
#   copy .env.example .env    (Windows CMD)
#   cp .env.example .env      (PowerShell)
# NUNCA subas el archivo .env a GitHub (ya está protegido en .gitignore).
# ==============================================================================

# --- Entorno General ---
ENVIRONMENT=local
PROJECT_NAME=urbanmove

# --- PostgreSQL (Infraestructura de Bases de Datos) ---
# Puerto: 5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=urbanmove
POSTGRES_PASSWORD=urbanmove_secure_password
POSTGRES_DB=postgres

# --- RabbitMQ (Bus de Eventos Asíncronos) ---
# Puertos: 5672 (AMQP) | 15672 (Consola Web de Administración)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=urbanmove
RABBITMQ_DEFAULT_PASS=urbanmove_broker_pass
RABBITMQ_EVENTS_EXCHANGE=urbanmove.events

# --- LocalStack (Emulador AWS S3 para el Data Lake y SQS) ---
# Puerto: 4566 (Gateway unificado de AWS)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=eu-west-1
S3_BUCKET_NAME=urbanmove-lake

# --- Microservicio de Reservas [US-07] (Java 17 + Spring Boot) ---
# Puerto: 8106
RESERVATIONS_SERVICE_PORT=8106
RESERVATIONS_DB_NAME=urbanmove_reservations
URBANMOVE_INTERNAL_AUTH_TOKEN=urbanmove-internal-secret-token-2026
URBANMOVE_RESERVATION_TTL_MINUTES=15
