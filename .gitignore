# --- Variables de entorno y secretos ---
.env
.env.local
.env.*.local
*.env
!.env.example

# --- Java & Maven (services/) ---
target/
**/target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.war
*.ear
*.jar

# --- Frontend & Node.js (clients/) ---
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
dist/
**/dist/
build/
**/build/

# --- Python & Serverless (lambdas/) ---
__pycache__/
**/__pycache__/
*.py[cod]
*.pyc
*$py.class
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
.eggs/
wheels/
*.egg

# --- Terraform & Cloud Infrastructure (infra/) ---
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.lock.hcl
crash.log

# --- Almacenamiento y volúmenes locales de Docker ---
postgres_data/
rabbitmq_data/
minio_data/
.docker-data/
docker-data/
*.db
*.sqlite

